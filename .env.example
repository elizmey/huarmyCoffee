# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# --- Base de datos ---
# Local: variables sueltas. Vercel/Neon/Supabase: usa DATABASE_URL (prioridad).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=huarmy_db
DB_USER=huarmy_user
DB_PASSWORD=change_me
# En la nube deja DB_SSL vacío (se activa solo). En local no hace falta.

# --- Backend / API (server/server.js) ---
# OJO: no usar el nombre "PORT" — react-scripts (CRA) también lo lee para
# su propio dev server y colisiona con este puerto del backend Express.
# En Vercel no hace falta API_PORT (Vercel asigna el puerto).
API_PORT=3001
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES=24h
FRONTEND_URL=http://localhost:3000

# --- Scripts de seed (server/seed.js, server/clearBusinessData.js) ---
# Definen las credenciales de las cuentas iniciales admin/recepcionista.
SEED_ADMIN_EMAIL=admin@huarmycoffee.com
SEED_ADMIN_PASSWORD=change_me
SEED_RECEPCIONISTA_EMAIL=recepcionista@huarmycoffee.com
SEED_RECEPCIONISTA_PASSWORD=change_me

# --- Frontend (Create React App solo expone variables con prefijo REACT_APP_) ---
REACT_APP_API_URL=/api
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
